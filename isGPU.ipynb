    "import torch\n",
    "\n",
    "# 1. GPU 활성화 여부 (True가 나와야 합니다)\n",
    "print(f\"GPU 활성 상태: {torch.cuda.is_available()}\")\n",
    "\n",
    "# 2. 어떤 GPU가 잡혔는지 확인 (NVIDIA A100... 이 나와야 합니다)\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"사용 중인 GPU: {torch.cuda.get_device_name(0)}\")\n",
    "else:\n",
    "    print(\"현재 CPU 모드입니다. 커널 설정을 다시 확인해주세요.\")"
   ]
