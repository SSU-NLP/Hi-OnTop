# Hi-OnTop 실험용 env  
#
# Hi-OnTop 분절기 본체는 로컬 인코더(MiniLM-int8 ONNX)로 돌아 API 키가 필요 없다.
# 키가 필요한 건 LLM 비교 baseline(Qwen3.5-27b, offline/buffer) 호출뿐.

# Crts 프록시 (OpenAI 호환)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.ssunlp.co.kr/v1
OPENAI_MODEL=openrouter/

# Cloudflare Access service token (Crts 프록시가 CF Access 게이트웨이 뒤에 있을 때 필수).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=